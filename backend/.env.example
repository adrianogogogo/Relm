# Environment
NODE_ENV=development

# Server
PORT=3003

# Database
DATABASE_URL="postgresql://postgres:CHANGE_THIS_DB_PASSWORD@localhost:5432/relm_careplus_dev?schema=public"

# JWT
JWT_SECRET="dev_secret_not_for_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_not_for_production"
JWT_REFRESH_EXPIRES_IN="7d"
CUSTOMER_JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_DIFFERENT_FROM_JWT_SECRET"

# CORS
CORS_ORIGIN="http://localhost:8080"

# Application
APP_NAME="Relm Care+ [DEV]"
APP_URL="http://localhost:8080"
API_URL="http://localhost:3003"

# ── LLM (assistente de marketing) ─────────────────────────────────────────────
# Chave do provedor. Sem ela o assistente cai no fallback de copy pronta.
OPENAI_API_KEY=
# Troca de provedor sem mexer em código: qualquer host que fale o dialeto da
# API da OpenAI serve. Deixe VAZIO para usar a OpenAI.
#   OpenRouter (dá acesso a Claude/Gemini/Llama): https://openrouter.ai/api/v1
#   Groq:     https://api.groq.com/openai/v1
#   DeepSeek: https://api.deepseek.com
#   Ollama local: http://localhost:11434/v1
# Atenção: geração de imagem (DALL-E) só existe na OpenAI — com baseURL
# preenchida, a imagem é pulada em vez de falhar a cada chamada.
OPENAI_BASE_URL=
# Modelo usado quando a tela não escolhe um. Troque junto com OPENAI_BASE_URL:
# ex. anthropic/claude-sonnet-4.5 no OpenRouter, llama-3.3-70b no Groq.
LLM_DEFAULT_MODEL=gpt-4o-mini

# Disparo de campanha em massa. Fica DESLIGADO até existir template de campanha
# de verdade, filtro de marketingConsent e link de descadastro. Ver o comentário
# em email-crm.service.ts:triggerCampaign antes de ligar.
EMAIL_CAMPAIGN_SEND_ENABLED=false
