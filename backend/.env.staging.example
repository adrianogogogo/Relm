# Environment
NODE_ENV=staging

# Server
PORT=3002

# Database
DATABASE_URL="postgresql://postgres:CHANGE_THIS_DB_PASSWORD@localhost:5432/relm_careplus_staging?schema=public"

# JWT
JWT_SECRET="STAGING_SECRET_KEY_CHANGE_ME"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="STAGING_REFRESH_SECRET_KEY_CHANGE_ME"
JWT_REFRESH_EXPIRES_IN="7d"
CUSTOMER_JWT_SECRET="STAGING_CUSTOMER_SECRET_KEY_CHANGE_ME"

# CORS
CORS_ORIGIN="https://staging-careplus.relmbikes.com.br"

# Application
APP_NAME="Relm Care+ [STAGING]"
APP_URL="https://staging-careplus.relmbikes.com.br"
API_URL="https://staging-api-careplus.relmbikes.com.br"
