// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model Customer {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash") // Null para cadastros via garantia
  fullName     String    @map("full_name")
  phone        String
  cpf          String? // Opcional, normalizado (11 dígitos)
  birthDate    DateTime? @map("birth_date")
  address      String?
  city         String?
  state        String?
  country      String?   @default("Brasil")
  zipCode      String?   @map("zip_code")

  // Loja de compra
  storeId String? @map("store_id")

  // Observações internas
  notes String? @db.Text

  // Status
  active Boolean @default(true)

  // Marketing
  marketingConsent Boolean @default(false) @map("marketing_consent")

  // HelmDesk integration
  helmdeskUserId String? @map("helmdesk_user_id")

  // Password reset
  resetPasswordToken   String?   @unique @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")

  // Tokens
  refreshToken String? @map("refresh_token") @db.Text

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // V2 Expansão
  currentTier TierLevel @default(CARE) @map("current_tier")

  // Referral (Wave 3)
  referralCode String? @unique @map("referral_code")
  referredById String? @map("referred_by_id")

  // Gamification (Wave 4)
  leaderboardOptIn Boolean @default(false) @map("leaderboard_opt_in")
  nickname         String?

  // Relations
  store                  Store?                  @relation(fields: [storeId], references: [id])
  referredBy             Customer?               @relation("CustomerReferrals", fields: [referredById], references: [id])
  referrals              Customer[]              @relation("CustomerReferrals")
  warrantyClaims         WarrantyClaim[]
  sales                  Sale[]
  benefitMemberships     BenefitMembership[]
  eventRegistrations     EventRegistration[]
  newsletterSubscription NewsletterSubscription?
  insuranceQuotes        InsuranceQuote[]
  insurancePolicies      InsurancePolicy[]
  privacyConsents        PrivacyConsent[]
  subscription           Subscription?
  pointsLedger           PointsLedger[]
  serviceOrders          ServiceOrder[]
  vouchers               Voucher[]
  payments               Payment[]
  referralsSent          Referral[]              @relation("ReferrerReferrals")
  referralReceived       Referral?               @relation("ReferredReferrals")
  customerAchievements   CustomerAchievement[]

  @@index([email])
  @@index([cpf])
  @@index([storeId])
  @@index([active])
  @@map("customers")
}

model Product {
  id                    String    @id @default(uuid())
  // serialNumber é da UNIDADE (preenchido na garantia). Catálogo (cadastro
  // admin por modelo) não tem série — por isso é opcional.
  serialNumber          String?   @unique @map("serial_number")
  name                  String? // Nome comercial do produto (catálogo)
  sku                   String? // ponytail: SKU livre, não-único por ora
  brand                 String    @default("Relm Bikes")
  productType           String?   @map("product_type") // Road, MTB, Gravel, E-bike, Acessórios
  model                 String?
  year                  Int? // Ano do modelo
  description           String?   @db.Text
  purchaseDate          DateTime? @map("purchase_date")
  purchaseInvoiceNumber String?   @map("purchase_invoice_number")
  purchaseStoreName     String?   @map("purchase_store_name")
  storeId               String?   @map("store_id")
  price                 Decimal?  @map("price") @db.Decimal(10, 2)

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  store             Store?            @relation(fields: [storeId], references: [id])
  warrantyClaims    WarrantyClaim[]
  insuranceQuotes   InsuranceQuote[]
  insurancePolicies InsurancePolicy[]
  saleItems         SaleItem[]
  pointsRule        PointsRule?

  @@index([serialNumber])
  @@index([storeId])
  @@map("products")
}

model Store {
  id        String   @id @default(uuid())
  tradeName String   @map("trade_name")
  legalName String   @map("legal_name")
  cnpj      String?  @unique
  aliases   String[] // Variações do nome
  email     String?
  phone     String?
  address   String?
  city      String
  state     String
  zipCode   String?  @map("zip_code")
  latitude  String? // Coordenada geográfica
  longitude String? // Coordenada geográfica
  logoUrl   String?  @map("logo_url") // URL da logomarca da loja
  active    Boolean  @default(true)

  // HelmDesk integration
  helmdeskStoreId String? @map("helmdesk_store_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products       Product[]
  users          User[]
  customers      Customer[]
  warrantyClaims WarrantyClaim[]
  storeUsers     StoreUser[]
  serviceOrders  ServiceOrder[]
  sales          Sale[]
  storeServices  StoreService[]
  landingPages   LandingPage[]

  @@index([city, state])
  @@map("stores")
}

model StoreUser {
  id           String  @id @default(uuid())
  storeId      String  @map("store_id")
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  role         String  @default("STORE_ADMIN")
  isActive     Boolean @default(true) @map("is_active")

  // Password reset
  resetPasswordToken   String?   @unique @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([email])
  @@map("store_users")
}

enum UserRole {
  ADMIN_RELM
  GERENTE_RELM
  SUPORTE_RELM
  LOJA
  DISTRIBUIDOR
  CLIENTE
  INSTRUTOR
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole
  storeId       String?  @map("store_id")
  distributorId String?  @map("distributor_id")
  // Vínculo do usuário INSTRUTOR com o seu registro. Mesmo padrão do storeId
  // acima: o token não carrega este id, o service busca no banco (plano 010).
  instructorId  String?  @map("instructor_id")
  active        Boolean  @default(true)

  // Tokens
  refreshToken String? @map("refresh_token") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  store          Store?          @relation(fields: [storeId], references: [id])
  distributor    Distributor?    @relation(fields: [distributorId], references: [id])
  instructor     Instructor?     @relation(fields: [instructorId], references: [id])
  // warrantyEvents WarrantyEvent[] // DEPRECATED (fase 4)
  assignedClaims WarrantyClaim[] @relation("ClaimAssignee")
  auditLogs      AuditLog[]
  salesSold      Sale[]          @relation("SaleSeller")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Distributor {
  id        String  @id @default(uuid())
  tradeName String  @map("trade_name")
  legalName String  @map("legal_name")
  cnpj      String? @unique
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users User[]

  @@map("distributors")
}

// ============================================
// WARRANTY MODULE
// ============================================

// enum WarrantyStatus {
//   RECEBIDO
//   EM_ANALISE
//   AGUARDANDO_CLIENTE
//   APROVADO
//   REPROVADO
//   FINALIZADO
//   CANCELADO
// }

enum LinkStatus {
  PENDING_REVIEW
  CONFIRMED
  NOT_FOUND
}

model WarrantyClaim {
  id             String @id @default(uuid())
  protocolNumber String @unique @map("protocol_number")

  // Relacionamentos
  customerId String  @map("customer_id")
  productId  String  @map("product_id")
  storeId    String? @map("store_id")

  // Dados da nota fiscal
  invoiceNumber        String  @map("invoice_number")
  invoiceAttachmentUrl String? @map("invoice_attachment_url") // V2

  // Dados da loja (informados pelo cliente)
  purchaseStoreName  String  @map("purchase_store_name")
  purchaseStoreCity  String? @map("purchase_store_city")
  purchaseStoreState String? @map("purchase_store_state")

  // Status
  linkStatus LinkStatus @default(PENDING_REVIEW) @map("link_status")
  // status → removido na fase 4. Agora o fluxo é controlado por statusId (FK warranty_statuses).
  statusId   Int?       @map("status_id")

  // Observações
  customerNotes   String? @map("customer_notes") @db.Text
  adminNotes      String? @map("admin_notes") @db.Text
  rejectionReason String? @map("rejection_reason") @db.Text
  resolution      String? @db.Text

  // Token de validação
  validationToken  String?   @unique @map("validation_token")
  tokenGeneratedAt DateTime? @map("token_generated_at")
  validatedAt      DateTime? @map("validated_at")

  // Email de aprovação
  approvalEmailSentAt DateTime? @map("approval_email_sent_at")
  approvedByUserId    String?   @map("approved_by_user_id")
  approvedAt          DateTime? @map("approved_at")

  // Custo da garantia para a empresa (informado por admin/gerente)
  cost Decimal? @map("cost") @db.Decimal(10, 2)

  // Responsavel atual + fechamento automatico (Onda 4)
  assignedToUserId String?   @map("assigned_to_user_id")
  autoCloseAt      DateTime? @map("auto_close_at")

  // HelmDesk integration
  helmdeskTicketId String? @map("helmdesk_ticket_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer    Customer             @relation(fields: [customerId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  store       Store?               @relation(fields: [storeId], references: [id])
  // events   WarrantyEvent[] // DEPRECATED (fase 4)
  tasks       WarrantyTask[]
  attachments WarrantyAttachment[]
  assignedTo  User?                @relation("ClaimAssignee", fields: [assignedToUserId], references: [id])
  statusDef   WarrantyStatusDef?   @relation(fields: [statusId], references: [id])
  history     WarrantyHistory[]
  solutions   WarrantySolution[]

  @@index([protocolNumber])
  @@index([customerId])
  @@index([statusId])
  @@index([createdAt])
  @@index([assignedToUserId])
  @@map("warranty_claims")
}

// ============================================
// NOVO WORKFLOW DE STATUS & SOLUÇÕES (RelmDesk-style)
// ============================================

// Status configuráveis do workflow (substitui o enum WarrantyStatus).
model WarrantyStatusDef {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  color       String  @default("#666666")
  sortOrder   Int     @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")
  description String?

  claims WarrantyClaim[]

  @@map("warranty_statuses")
}

// Timeline imutável (substitui WarrantyEvent). Append-only.
model WarrantyHistory {
  id           String   @id @default(uuid())
  claimId      String   @map("claim_id")
  userId       String?  @map("user_id")
  actionType   String   @map("action_type")
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  note         String?  @db.Text
  isInternal   Boolean  @default(true) @map("is_internal")
  ballFromId   String?  @map("ball_from_id")
  ballToId     String?  @map("ball_to_id")
  statusFromId Int?     @map("status_from_id")
  statusToId   Int?     @map("status_to_id")
  createdAt    DateTime @default(now()) @map("created_at")

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([createdAt])
  @@map("warranty_history")
}

// Soluções propostas com autorização em dois níveis (gestor → diretor).
model WarrantySolution {
  id                      String    @id @default(uuid())
  claimId                 String    @map("claim_id")
  description             String    @db.Text
  solutionType            String    @default("outro") @map("solution_type") // reparo/troca/reembolso/cortesia/outro
  hasCost                 Boolean   @default(false) @map("has_cost")
  costValue               Decimal?  @map("cost_value") @db.Decimal(10, 2)
  costNotes               String?   @map("cost_notes") @db.Text
  status                  String    @default("pendente") // pendente/aprovado/reprovado
  proposedBy              String?   @map("proposed_by")
  approvedBy              String?   @map("approved_by")
  approvedAt              DateTime? @map("approved_at")
  rejectionReason         String?   @map("rejection_reason") @db.Text
  requiresDirector        Boolean   @default(false) @map("requires_director")
  authorizationLevel      String    @default("gestor") @map("authorization_level") // gestor/diretor/concluido
  directorApprovedBy      String?   @map("director_approved_by")
  directorApprovedAt      DateTime? @map("director_approved_at")
  directorRejectionReason String?   @map("director_rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([authorizationLevel, status])
  @@map("warranty_solutions")
}

// Modelo WarrantyEvent removido na Fase 4. Tabela preservada no banco para histórico.

// Tarefas operacionais de uma garantia (ex.: "Enviar pneu para a fabrica").
// Status livre em pt-BR: pendente | concluida | cancelada. Responsavel (assignee)
// e texto livre — nao ha FK para User (pode ser "Gestor Bikes", time externo, etc).
model WarrantyTask {
  id              String    @id @default(uuid())
  claimId         String    @map("claim_id")
  title           String
  status          String    @default("pendente")
  assignee        String?
  assigneeRole    String?   @map("assignee_role")
  stage           String? // etapa do fluxo (WarrantyStatus) que originou a tarefa
  dueDate         DateTime? @map("due_date")
  createdByUserId String?   @map("created_by_user_id")
  autoGenerated   Boolean   @default(false) @map("auto_generated")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("warranty_tasks")
}

// Anexos de uma garantia. ponytail: armazenamento em disco do servidor
// (storagePath). Upgrade path: S3/object storage se o volume crescer.
model WarrantyAttachment {
  id               String  @id @default(uuid())
  claimId          String  @map("claim_id")
  fileName         String  @map("file_name")
  mimeType         String  @map("mime_type")
  size             Int
  storagePath      String  @map("storage_path")
  uploadedByUserId String? @map("uploaded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("warranty_attachments")
}

// Templates de tarefas automáticas vinculados a transições da FSM (Onda 7).
// Ao transicionar para o status `toStatus`, o backend cria WarrantyTasks
// automaticamente com base nos templates ativos.
// Modelo WarrantyTaskTemplate removido na Fase 4. Tabela preservada no banco para histórico.

// ============================================
// BENEFITS MODULE
// ============================================

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model BenefitMembership {
  id         String           @id @default(uuid())
  customerId String           @map("customer_id")
  status     MembershipStatus @default(ACTIVE)
  tier       String? // V2: PRIME, VIP, etc.
  joinedAt   DateTime         @default(now()) @map("joined_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer    Customer            @relation(fields: [customerId], references: [id])
  redemptions BenefitRedemption[]

  @@unique([customerId])
  @@map("benefit_memberships")
}

model Benefit {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  terms       String?  @db.Text
  validFrom   DateTime @map("valid_from")
  validUntil  DateTime @map("valid_until")
  active      Boolean  @default(true)

  // Segmentação
  targetRoles String[] @default([]) @map("target_roles") // CLIENTE, LOJA, DISTRIBUIDOR, vazio = todos

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  redemptions BenefitRedemption[]

  @@index([active, validFrom, validUntil])
  @@map("benefits")
}

model BenefitRedemption {
  id           String  @id @default(uuid())
  benefitId    String  @map("benefit_id")
  customerId   String? @map("customer_id")
  storeId      String? @map("store_id")
  membershipId String  @map("membership_id")

  redeemedAt DateTime @default(now()) @map("redeemed_at")

  // Relations
  benefit    Benefit           @relation(fields: [benefitId], references: [id])
  membership BenefitMembership @relation(fields: [membershipId], references: [id])

  @@index([redeemedAt])
  @@map("benefit_redemptions")
}

// ============================================
// INSURANCE MODULE
// ============================================

model InsuranceQuote {
  id             String  @id @default(uuid())
  protocolNumber String  @unique @map("protocol_number")
  customerId     String  @map("customer_id")
  productId      String? @map("product_id")

  // Dados do seguro
  bikeValue Decimal? @map("bike_value") @db.Decimal(10, 2)
  city      String?
  state     String?

  // V2: campos de integração
  quoteValue       Decimal?  @map("quote_value") @db.Decimal(10, 2)
  insuranceCompany String?   @map("insurance_company")
  status           String    @default("PENDING")
  quotedAt         DateTime? @map("quoted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer          @relation(fields: [customerId], references: [id])
  product  Product?          @relation(fields: [productId], references: [id])
  policies InsurancePolicy[]

  @@index([protocolNumber])
  @@index([customerId])
  @@map("insurance_quotes")
}

// ============================================
// APÓLICE DE SEGURO (entidade de 1ª classe) — ONDA 2
// ============================================
//
// A apólice é genérica: a seguradora parceira ainda não está definida. Nasce da
// conversão de uma cotação (quoteId) OU sem cotação (apólice do 1º ano incluída
// para quem compra bike e ganha 1 ano de Plus).
enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model InsurancePolicy {
  id           String       @id @default(uuid())
  policyNumber String       @unique @map("policy_number")
  insurer      String
  coverage     String?      @db.Text
  premium      Decimal?     @db.Decimal(10, 2)
  status       PolicyStatus @default(ACTIVE)
  startsAt     DateTime     @map("starts_at")
  expiresAt    DateTime     @map("expires_at")

  quoteId    String? @map("quote_id")
  customerId String  @map("customer_id")
  productId  String? @map("product_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  quote    InsuranceQuote? @relation(fields: [quoteId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  product  Product?        @relation(fields: [productId], references: [id])

  @@index([customerId, status])
  @@index([expiresAt])
  @@map("insurance_policies")
}

// ============================================
// EVENTS MODULE
// ============================================

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  location        String
  startAt         DateTime @map("start_at")
  endAt           DateTime @map("end_at")
  maxParticipants Int?     @map("max_participants")
  active          Boolean  @default(true)

  // Segmentação
  targetRoles String[] @default([]) @map("target_roles") // CLIENTE, LOJA, DISTRIBUIDOR, vazio = todos

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  registrations EventRegistration[]

  @@index([startAt])
  @@map("events")
}

model EventRegistration {
  id         String    @id @default(uuid())
  eventId    String    @map("event_id")
  customerId String    @map("customer_id")
  attended   Boolean   @default(false)
  attendedAt DateTime? @map("attended_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([eventId, customerId])
  @@index([eventId])
  @@map("event_registrations")
}

// ============================================
// NEWSLETTER MODULE
// ============================================

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscription {
  id         String             @id @default(uuid())
  email      String             @unique
  customerId String?            @unique @map("customer_id")
  status     SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([email])
  @@index([status])
  @@map("newsletter_subscriptions")
}

// ============================================
// CONTENT MODULE
// ============================================

model ContentItem {
  id          String    @id @default(uuid())
  title       String
  body        String    @db.Text // Markdown
  category    String?
  targetRole  String?   @map("target_role") // LOJA, DISTRIBUIDOR, null = todos
  publishedAt DateTime? @map("published_at")
  active      Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, publishedAt])
  @@index([targetRole])
  @@map("content_items")
}

// Landing page de campanha (Step 6). `conteudo` guarda o PaginaGerada inteiro
// — blocos + paleta — porque a forma vem do schema de blocos, não do banco:
// normalizar bloco em tabela obrigaria migration a cada tipo novo.
//
// `storeId` é coluna solta, sem FK: a página é da campanha, não da loja, e a
// loja só entra no rodapé. Apagar uma loja não pode derrubar a campanha.
model LandingPage {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String  @default("")
  description String? @db.Text
  blocksJson  Json    @map("blocks_json")
  active      Boolean @default(true)
  viewCount   Int     @default(0) @map("view_count")
  storeId     String? @map("store_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store? @relation(fields: [storeId], references: [id])

  @@index([active])
  @@index([slug])
  @@index([storeId])
  @@map("landing_pages")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  message     String   @db.Text
  targetRole  String?  @map("target_role") // LOJA, DISTRIBUIDOR, null = todos
  publishedAt DateTime @default(now()) @map("published_at")
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, publishedAt])
  @@map("announcements")
}

// ============================================
// LGPD & AUDIT
// ============================================

model PrivacyPolicyVersion {
  id      String  @id @default(uuid())
  version String  @unique
  content String  @db.Text // Markdown
  active  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  consents PrivacyConsent[]

  @@map("privacy_policy_versions")
}

model PrivacyConsent {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  policyVersionId String   @map("policy_version_id")
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent") @db.Text

  // Relations
  policyVersion PrivacyPolicyVersion @relation(fields: [policyVersionId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("privacy_consents")
}

// Ator polimórfico, mesmo padrão do Notification: quem age não vive numa
// tabela só — equipe Relm em `users`, lojista em `store_users`, cliente em
// `customers`. `userId` continua sendo a FK do subconjunto USER (é o que a tela
// de logs usa para mostrar nome e papel); os demais atores só têm
// actorType+actorId, com o e-mail no metadata para leitura humana.
//   actorType: "USER" | "STORE_USER" | "CUSTOMER" | "ANONIMO"
model AuditLog {
  id        String  @id @default(uuid())
  userId    String? @map("user_id")
  actorType String? @map("actor_type")
  actorId   String? @map("actor_id")
  action    String // EXPORT_DATA, VIEW_SENSITIVE, etc.
  entity    String // customers, warranty_claims, etc.
  entityId  String? @map("entity_id")
  metadata  Json?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
  @@index([actorType, actorId, createdAt])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS MODULE
// ============================================

// Recipiente polimórfico: a equipe Relm vive na tabela `users` (User) e os
// usuários de loja vivem em `store_users` (StoreUser) — tabelas distintas, sem
// FK única possível. Por isso usamos recipientType + recipientId.
//   recipientType: "USER"       -> users.id       (equipe/admin/gerente/suporte)
//   recipientType: "STORE_USER" -> store_users.id (lojistas)
model Notification {
  id            String    @id @default(uuid())
  recipientType String    @map("recipient_type") // USER | STORE_USER
  recipientId   String    @map("recipient_id")
  type          String // WARRANTY_NEW | INSURANCE_NEW | EVENT_REGISTRATION | CUSTOMER_NEW
  title         String
  message       String    @db.Text
  link          String?
  read          Boolean   @default(false)
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([recipientType, recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// BANNERS MODULE
// ============================================

model Banner {
  id           String  @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String  @map("image_url")
  linkUrl      String? @map("link_url")
  linkText     String? @map("link_text")
  displayOrder Int     @default(0) @map("display_order")
  active       Boolean @default(true)

  // Segmentação por público e página
  audience String  @default("PUBLIC") // PUBLIC | CLIENTE | LOJA | ADMIN
  page     String? // chave da página dentro do público (NULL = todas as páginas)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([displayOrder])
  @@index([audience, page, active])
  @@map("banners")
}

// ============================================
// V2 EXPANSÃO MODULES
// ============================================

enum TierLevel {
  CARE
  PLUS
}

enum SubStatus {
  ACTIVE
  EXPIRED
  DOWNGRADED
}

enum PointTxType {
  EARN
  REDEEM
  EXPIRE
}

// De qual saldo a linha fala.
//   ACUMULAVEL — o saldo histórico: acumula, expira 12 meses após o EARN.
//   MENSAL     — saldo do Plus que renova todo mês e não acumula (uso-ou-perde).
// O bucket MENSAL não tem linha de EARN: a cota vem do ENTITLEMENTS/ClubSettings
// e o saldo é DERIVADO (cota menos o consumido no mês corrente), igual ao
// serviceAllowancePerYear. Só os REDEEM mensais viram linha.
enum PointsBucket {
  ACUMULAVEL
  MENSAL
}

// Como a regra converte um item vendido em pontos.
//   FIXO     — `value` pontos por unidade, independente do preço.
//   POR_REAL — `value` pontos por real do subtotal do item.
enum PointsRuleMode {
  FIXO
  POR_REAL
}

enum PlusCoverageRule {
  FREE
  DISCOUNT_PERCENT
  FIXED_PRICE
}

enum ServiceType {
  REVISION_BASIC
  REVISION_COMPLETE
  DIAGNOSTIC
  LAVAGEM_LUBRIFICACAO // Wave 6
  BUSCA_ENTREGA // Wave 6 — logística leva-e-traz
  BIKE_FITTING // Wave 6
}

enum PriorityLevel {
  STANDARD
  HIGH_PRIORITY
}

enum ServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Wave 6 — etapas da logística leva-e-traz (só para serviceType=BUSCA_ENTREGA)
enum LogisticsStatus {
  COLETA_AGENDADA
  EM_TRANSPORTE_COLETA
  NA_OFICINA
  EM_TRANSPORTE_ENTREGA
  ENTREGUE
}

enum VoucherStatus {
  UNUSED
  USED
  EXPIRED
}

model Subscription {
  id          String    @id @default(uuid())
  customerId  String    @unique @map("customer_id")
  customer    Customer  @relation(fields: [customerId], references: [id])
  tier        TierLevel @default(CARE)
  status      SubStatus
  activatedAt DateTime  @default(now()) @map("activated_at")
  expiresAt   DateTime? @map("expires_at") // Null se o tier for CARE
  updatedAt   DateTime  @updatedAt @map("updated_at")
  autoRenew   Boolean   @default(false) @map("auto_renew")

  payments Payment[]

  @@index([customerId, status])
  @@map("subscriptions")
}

// ============================================
// PAGAMENTOS (anuidade Plus) — ONDA 1
// ============================================

enum PaymentMethod {
  MANUAL_LOJA // registrado pela loja (fecha a cobrança presencial)
  MANUAL_RELM // registrado direto pela Relm
  GATEWAY // reservado para gateway futuro (Asaas/MP/etc.)
}

enum PaymentStatus {
  PENDING // aguardando confirmação da Relm (registro por loja)
  CONFIRMED // pago/confirmado → renova a assinatura
  CANCELLED
}

// Pagamento da anuidade Plus. Registro manual hoje; pronto para gateway futuro
// via `gatewayId` + method GATEWAY (PaymentGatewayService).
model Payment {
  id               String        @id @default(uuid())
  subscriptionId   String        @map("subscription_id")
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId       String        @map("customer_id")
  customer         Customer      @relation(fields: [customerId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  // Quem registrou: id do User (equipe) ou do StoreUser (lojista).
  registeredById   String        @map("registered_by_id")
  registeredByType String        @map("registered_by_type") // "USER" | "STORE_USER"
  gatewayId        String?       @map("gateway_id") // reservado p/ gateway futuro
  paidAt           DateTime?     @map("paid_at")
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

// Configurações calibráveis do clube (valor da anuidade, valor do ponto, etc.).
model ClubSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("club_settings")
}

model PointsLedger {
  id              String       @id @default(uuid())
  customerId      String       @map("customer_id")
  customer        Customer     @relation(fields: [customerId], references: [id])
  transactionType PointTxType  @map("transaction_type")
  // Linhas antigas são todas do saldo histórico — daí o default.
  bucket          PointsBucket @default(ACUMULAVEL)
  amount          Int
  description     String
  referenceId     String?      @map("reference_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  expiresAt       DateTime?    @map("expires_at")
  isExpired       Boolean      @default(false) @map("is_expired")

  @@index([customerId])
  @@map("points_ledger")
}

// "comprou uma roda a gente já sabe quantos pontos a gente vai dar" [reunião 07/08].
// Exatamente UM dos alvos é preenchido: productId (override de um produto
// específico) ou productType (a categoria inteira). Resolução em
// points.service.ts, com precedência produto > categoria > multiplicador do
// tier — item sem regra continua pontuando como sempre pontuou.
model PointsRule {
  id          String         @id @default(uuid())
  productId   String?        @unique @map("product_id")
  productType String?        @unique @map("product_type")
  mode        PointsRuleMode
  value       Decimal        @db.Decimal(10, 2)
  active      Boolean        @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id])

  @@map("points_rules")
}

model ServiceOrder {
  id               String        @id @default(uuid())
  customerId       String        @map("customer_id")
  customer         Customer      @relation(fields: [customerId], references: [id])
  storeId          String        @map("store_id")
  store            Store         @relation(fields: [storeId], references: [id])
  storeServiceId   String?       @map("store_service_id")
  storeService     StoreService? @relation(fields: [storeServiceId], references: [id])
  bikeModel        String        @map("bike_model")
  serviceType      ServiceType   @default(REVISION_BASIC) @map("service_type")
  priceCharged     Decimal?      @map("price_charged") @db.Decimal(10, 2)
  estimatedMinutes Int?          @map("estimated_minutes")
  priority         PriorityLevel
  deliveryRequest  Boolean       @default(false) @map("delivery_request")
  scheduledFor     DateTime      @map("scheduled_for")
  status           ServiceStatus
  createdAt        DateTime      @default(now()) @map("created_at")

  // Wave 6 — logística leva-e-traz (só quando serviceType=BUSCA_ENTREGA)
  pickupAddress   String?          @map("pickup_address")
  logisticsStatus LogisticsStatus? @map("logistics_status")

  @@index([customerId, serviceType, createdAt])
  @@index([storeServiceId])
  @@map("service_orders")
}

model MasterService {
  id                         String           @id @default(uuid())
  name                       String
  description                String?          @db.Text
  category                   String?
  defaultEstimatedMinutes    Int              @default(60) @map("default_estimated_minutes")
  defaultPrice               Decimal?         @map("default_price") @db.Decimal(10, 2)
  defaultPointsCost          Int?             @map("default_points_cost")
  defaultPlusRule            PlusCoverageRule @default(FREE) @map("default_plus_rule")
  defaultPlusPrice           Decimal?         @map("default_plus_price") @db.Decimal(10, 2)
  defaultPlusDiscountPercent Int?             @map("default_plus_discount_percent")
  active                     Boolean          @default(true)
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  storeServices StoreService[]

  @@map("master_services")
}

model StoreService {
  id                  String           @id @default(uuid())
  storeId             String           @map("store_id")
  store               Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  masterServiceId     String           @map("master_service_id")
  masterService       MasterService    @relation(fields: [masterServiceId], references: [id], onDelete: Cascade)
  customName          String?          @map("custom_name")
  customDescription   String?          @map("custom_description") @db.Text
  price               Decimal          @db.Decimal(10, 2)
  plusRule            PlusCoverageRule @default(FREE) @map("plus_rule")
  plusDiscountPercent Int?             @map("plus_discount_percent")
  plusPrice           Decimal?         @map("plus_price") @db.Decimal(10, 2)
  estimatedMinutes    Int              @default(60) @map("estimated_minutes")
  // Custo em pontos para resgatar este serviço. Null = não resgatável por
  // pontos — a própria ausência é o opt-out, sem flag separada.
  pointsCost          Int?             @map("points_cost")
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  serviceOrders ServiceOrder[]
  vouchers      Voucher[]

  @@unique([storeId, masterServiceId])
  @@index([storeId, active])
  @@map("store_services")
}

// ============================================
// ENGAGEMENT MODULE (Wave 3)
// ============================================

enum ReferralStatus {
  PENDING
  COMPLETED
}

model Referral {
  id            String         @id @default(uuid())
  referrerId    String         @map("referrer_id")
  referredId    String         @unique @map("referred_id")
  status        ReferralStatus @default(PENDING)
  pointsAwarded Int?           @map("points_awarded")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  referrer Customer @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referred Customer @relation("ReferredReferrals", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model CatalogItem {
  id           String     @id @default(uuid())
  title        String
  description  String     @db.Text
  pointsCost   Int        @map("points_cost")
  stock        Int        @default(0)
  active       Boolean    @default(true)
  // Pré-venda exclusiva por tier (Wave 5)
  presaleUntil DateTime?  @map("presale_until")
  presaleTier  TierLevel? @map("presale_tier")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  vouchers Voucher[]

  @@map("catalog_items")
}

// ============================================
// PARTNERS MODULE (Wave 5)
// ============================================

enum PartnerCategory {
  CAFE
  HOTEL
  PROVA
  OUTRO
}

model Partner {
  id          String          @id @default(uuid())
  name        String
  category    PartnerCategory
  description String?         @db.Text
  benefit     String
  minTier     TierLevel       @default(CARE) @map("min_tier")
  logoUrl     String?         @map("logo_url")
  link        String?
  city        String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([active, minTier])
  @@map("partners")
}

// ============================================
// INSTRUTORES (plano 012)
// ============================================

// Especialidade do instrutor (treino de estrada, MTB, triathlon...). Tabela, e
// não enum nem String[], porque a Relm cadastra novas sem deploy.
model InstructorSpecialty {
  id          String       @id @default(uuid())
  name        String       @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  instructors Instructor[]

  @@map("instructor_specialties")
}

// Instrutor/assessoria exibido ao cliente. Sem repasse, sem comissão: a Relm
// apresenta o profissional e nada mais. Por isso NÃO existe campo de preço —
// o desconto é texto (`benefit`/`benefitPlus`), que sobrevive a reajuste e não
// coloca a Relm de fiadora de tabela de terceiro.
model Instructor {
  id              String    @id @default(uuid())
  name            String
  description     String?   @db.Text
  // Desconto válido para qualquer cliente do clube.
  benefit         String
  // Desconto adicional do Plus. O Care VÊ este texto (é o argumento de venda),
  // por isso nada aqui é escondido por tier.
  benefitPlus     String?   @map("benefit_plus")
  // Só sai da API depois que o cliente gera a credencial — é o que garante que
  // todo contato passe pelo sistema.
  phone           String
  link            String?
  logoUrl         String?   @map("logo_url")
  city            String?
  state           String? // UF
  // Atende online. Sem isso, cliente de cidade sem instrutor vê tela vazia.
  remote          Boolean   @default(false)
  active          Boolean   @default(true)
  // Aceite do termo no primeiro login. Nulo = painel bloqueado.
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specialties InstructorSpecialty[]
  users       User[]
  vouchers    Voucher[]

  @@index([active, state])
  @@map("instructors")
}

// Um voucher aponta para UM alvo: item do catálogo (prêmio físico), serviço de
// uma loja, ou instrutor. O ciclo — código, expiração, baixa no atendimento — é
// o mesmo, por isso o serviço reaproveita este model em vez de ter o seu próprio.
// EXCEÇÃO do alvo instrutor: é vínculo, não cupom. Nasce UNUSED e NUNCA vira
// USED — o instrutor consulta o status atual da assinatura, não queima código.
model Voucher {
  id             String        @id @default(uuid())
  code           String        @unique
  status         VoucherStatus @default(UNUSED)
  customerId     String        @map("customer_id")
  catalogItemId  String?       @map("catalog_item_id")
  storeServiceId String?       @map("store_service_id")
  instructorId   String?       @map("instructor_id")

  // Congelados no momento do resgate: `point_value_brl` muda com o tempo e o
  // acerto financeiro com a loja é offline — precisa do valor da época.
  pointsSpent Int?     @map("points_spent")
  brlValue    Decimal? @map("brl_value") @db.Decimal(10, 2)

  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  customer     Customer      @relation(fields: [customerId], references: [id])
  catalogItem  CatalogItem?  @relation(fields: [catalogItemId], references: [id])
  storeService StoreService? @relation(fields: [storeServiceId], references: [id])
  instructor   Instructor?   @relation(fields: [instructorId], references: [id])

  @@index([storeServiceId])
  // O vínculo ativo é procurado por (cliente, instrutor) antes de criar outro.
  @@index([instructorId, customerId, status])
  @@map("vouchers")
}

// ============================================
// GAMIFICATION MODULE (Wave 4)
// ============================================

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  customerAchievements CustomerAchievement[]

  @@map("achievements")
}

model CustomerAchievement {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([customerId, achievementId])
  @@index([customerId])
  @@map("customer_achievements")
}

// ============================================
// VENDAS (registro de venda na loja + vigência de garantia)
// ============================================

model Sale {
  id           String  @id @default(uuid())
  customerId   String  @map("customer_id")
  storeId      String? @map("store_id")
  soldByUserId String? @map("sold_by_user_id")

  saleDate      DateTime @map("sale_date")
  invoiceNumber String?  @map("invoice_number")

  // Nota fiscal: um arquivo por venda, no disco do servidor.
  // ponytail: disco local, igual aos anexos de garantia — trocar por S3 junto.
  invoiceStoragePath String? @map("invoice_storage_path")
  invoiceFileName    String? @map("invoice_file_name")
  invoiceMimeType    String? @map("invoice_mime_type")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id])
  store    Store?     @relation(fields: [storeId], references: [id])
  soldBy   User?      @relation("SaleSeller", fields: [soldByUserId], references: [id])
  items    SaleItem[]

  @@index([customerId])
  @@index([storeId])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String @map("sale_id")

  // Nome comercial digitado livremente pela loja no PDV. Obrigatório.
  // productId fica nulo até a curadoria da Relm vincular ao catálogo.
  commercialName String  @map("commercial_name")
  productId      String? @map("product_id")

  quantity     Int      @default(1)
  // ponytail: série não-única (digitação livre no PDV). Unicidade só depois da curadoria.
  serialNumber String?  @map("serial_number")
  unitPrice    Decimal? @map("unit_price") @db.Decimal(10, 2)

  // Vigência: prazo em dias informado na venda; warrantyEndsAt é DERIVADO
  // (saleDate + warrantyDays) e gravado para permitir consulta indexada.
  warrantyDays   Int?      @map("warranty_days")
  warrantyEndsAt DateTime? @map("warranty_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([serialNumber])
  @@index([productId])
  @@index([warrantyEndsAt])
  @@map("sale_items")
}

model EmailTemplate {
  id         String  @id @default(uuid())
  name       String
  slug       String  @unique
  subject    String
  /// Segundo texto que aparece na caixa de entrada, ao lado do assunto. Nasce
  /// da geração por IA; nullable porque template antigo não tem.
  preheader  String?
  bodyHtml   String  @map("body_html") @db.Text
  /// PaginaGerada — fonte de verdade do conteúdo. bodyHtml é o render guardado.
  blocksJson Json?   @map("blocks_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaigns EmailCampaign[]

  @@map("email_templates")
}

model EmailCampaign {
  id         String @id @default(uuid())
  // Sem campos de envio: este módulo gera e exporta HTML, o disparo acontece na
  // ferramenta de e-mail marketing. Segmento, status e contadores eram colunas
  // que nunca seriam preenchidas.
  title      String
  templateId String @map("template_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template EmailTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@map("email_campaigns")
}
